{
    "name": "infra",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": ">=24 <25",
        "yarn": "4.18.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "jsdom": "^31.0.0",
        "prettier": "3.9.10",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "scripts": {
        "serve": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest"
    }
}
